#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        system_layer_mo {
            bindings = <&mo 5>;
            key-positions = <53 56>;
        };
    };

    behaviors {
        gravel_accent_tilde_td: gravel_accent_tilde_td {
            compatible = "zmk,behavior-tap-dance";
            label = "GRAVEL_ACCENT_TILDE_TD";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&kp TILDE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";

            bindings = <
&kp ESCAPE        &kp N1  &kp N2    &kp N3    &kp N4  &kp N5                            &kp N6  &kp N7  &kp N8     &kp N9    &kp N0         &kp BACKSLASH
&kp TAB           &kp Q   &kp W     &kp E     &kp R   &kp T                             &kp Y   &kp U   &kp I      &kp O     &kp P          &kp BSPC
&kp LEFT_CONTROL  &kp A   &kp S     &kp D     &kp F   &kp G                             &kp H   &kp J   &kp K      &kp L     &kp SEMICOLON  &kp SQT
&kp LSHFT         &kp Z   &kp X     &kp C     &kp V   &kp B   &kp C_MUTE    &kp C_MUTE  &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH       &kp RSHFT
                          &kp LGUI  &kp LALT  &mo 3   &mo 1   &kp SPACE     &kp ENTER   &mo 2   &mo 4   &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_DN PG_UP>;

            label = "BASE";
        };

        symbol_layer {
            display-name = "SYMBOL";

            bindings = <
&gravel_accent_tilde_td  &trans     &trans          &trans            &trans          &trans                                  &trans                 &trans           &trans             &trans            &trans     &kp PIPE
&trans                   &kp TILDE  &kp LESS_THAN   &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS                    &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GREATER_THAN  &trans     &trans
&trans                   &kp EXCL   &kp AT          &kp HASH          &kp DLLR        &kp PRCNT                               &kp CARET              &kp AMPS         &kp KP_MULTIPLY    &kp LPAR          &kp RPAR   &kp QUESTION
&kp DOUBLE_QUOTES        &kp COLON  &kp UNDERSCORE  &kp MINUS         &kp KP_PLUS     &kp KP_EQUAL          &trans    &trans  &kp KP_EQUAL           &kp KP_PLUS      &kp MINUS          &kp UNDERSCORE    &kp COLON  &kp DOUBLE_QUOTES
                                    &trans          &trans            &trans          &trans                &trans    &trans  &trans                 &trans           &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_DN PG_UP>;

            label = "SYMBOL";
        };

        navigation_layer {
            display-name = "NAV";

            bindings = <
&trans  &trans      &trans     &trans       &trans       &trans                      &trans    &trans         &trans       &trans     &trans  &trans
&trans  &kp INS     &kp PSCRN  &kp K_CMENU  &kp LA(F4)   &trans                      &trans    &kp PAGE_DOWN  &kp PAGE_UP  &trans     &trans  &kp DEL
&trans  &trans      &trans     &trans       &trans       &kp CLCK                    &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans  &trans
&trans  &kp K_UNDO  &kp K_CUT  &kp K_COPY   &kp K_PASTE  &trans    &trans    &trans  &trans    &kp END        &kp HOME     &trans     &trans  &trans
                    &trans     &trans       &trans       &trans    &trans    &trans  &trans    &trans         &trans       &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_DN PG_UP>;

            label = "NAV";
        };

        number_layer {
            display-name = "NUMBER";

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N0  &kp N1  &kp N2  &kp N3  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_DN PG_UP>;
            label = "NUMBER";
        };

        function_layer {
            display-name = "FUNC";

            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                    &trans          &trans                &trans                &trans              &trans  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans                    &kp K_PREVIOUS  &trans                &trans                &kp K_NEXT          &trans  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                    &kp C_REWIND    &kp K_VOLUME_DOWN     &kp K_VOLUME_UP       &kp C_FAST_FORWARD  &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans    &trans  &trans          &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans              &trans  &trans
                &trans   &trans   &trans   &trans  &trans    &trans  &trans          &trans                &trans                &trans
            >;
            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_DN PG_UP>;

            label = "FUNC";
        };

        system_layer {
            display-name = "SYSTEM";

            bindings = <
&bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans       &trans      &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans       &trans      &trans  &trans
&out OUT_TOG  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans       &trans      &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans       &trans      &trans  &trans
                            &sys_reset    &bootloader   &trans        &trans        &trans    &trans  &trans  &trans  &bootloader  &sys_reset
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_DN PG_UP>;

            label = "SYSTEM";
        };
    };
};
